/* pages/hospitalization/index.wxss */
.page {
  background: #F5F7FA;
  min-height: 100vh;
}

/* ========== Header ========== */
.page-header {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  padding: 32rpx 24rpx 28rpx;
  border-radius: 0 0 24rpx 24rpx;
  display: flex;
  align-items: center;
}
.header-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-icon {
  width: 32rpx;
  height: 32rpx;
}
.header-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 48rpx;
}
.header-placeholder {
  width: 48rpx;
}

/* ========== Loading ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(59, 130, 246, 0.2);
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #9CA3AF;
}

/* ========== Empty State ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}
.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #9CA3AF;
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #D1D5DB;
}

/* ========== Wristband Card ========== */
.wristband-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}
.card-header {
  display: flex;
  align-items: center;
}
.hospital-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(59, 130, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hospital-icon-text {
  font-size: 40rpx;
}
.hospital-info {
  flex: 1;
  margin-left: 20rpx;
}
.hospital-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
}
.hospital-bed {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6B7280;
  display: block;
}
.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.status-badge.online {
  background: #F0FDF4;
  color: #16A34A;
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #16A34A;
}
.divider {
  height: 24rpx;
}

/* ========== Info Grid ========== */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0 24rpx;
}
.info-item {
  width: calc(50% - 12rpx);
  margin-bottom: 20rpx;
}
.info-label {
  font-size: 20rpx;
  color: #9CA3AF;
  display: block;
}
.info-value {
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  display: block;
  word-break: break-all;
}

/* ========== Section Cards ========== */
.section-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}
.section-more {
  font-size: 22rpx;
  color: #3B82F6;
}
.section-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #9CA3AF;
}

/* ========== Treatment List ========== */
.treatment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.treatment-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 20rpx;
  border-left: 6rpx solid #3B82F6;
}
.treatment-icon-bg {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(59, 130, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.treatment-icon {
  font-size: 32rpx;
}
.treatment-body {
  flex: 1;
  margin: 0 20rpx;
}
.treatment-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
}
.treatment-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6B7280;
  display: block;
}
.treatment-time {
  font-size: 22rpx;
  color: #9CA3AF;
  flex-shrink: 0;
}

/* ========== Verification List ========== */
.verification-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.verification-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 20rpx;
}
.verify-status-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #fff;
}
.verify-status-icon.success {
  background: #F0FDF4;
  color: #16A34A;
  border: 3rpx solid #BBF7D0;
}
.verify-status-icon.fail {
  background: #FEF2F2;
  color: #EF4444;
  border: 3rpx solid #FECACA;
}
.verify-body {
  flex: 1;
  margin: 0 16rpx;
}
.verify-purpose {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
}
.verify-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9CA3AF;
  display: block;
}
.verify-result {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.verify-result.success {
  background: #F0FDF4;
  color: #16A34A;
}
.verify-result.fail {
  background: #FEE2E2;
  color: #EF4444;
}

/* ========== Bottom Spacer ========== */
.bottom-spacer {
  height: 40rpx;
}
