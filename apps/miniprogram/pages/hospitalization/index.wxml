<!--pages/hospitalization/index.wxml-->
<view class="page">
  <!-- Header -->
  <view class="page-header">
    <view class="header-back" bindtap="goBack">
      <image class="back-icon" src="/assets/back.png" mode="aspectFit"></image>
    </view>
    <text class="header-title">住院治疗</text>
    <view class="header-placeholder"></view>
  </view>

  <scroll-view class="scroll-content" scroll-y>
    <!-- Loading -->
    <view wx:if="{{loading}}" class="loading-wrap">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- Empty state -->
    <view wx:else-if="{{!currentStay}}" class="empty-state">
      <image class="empty-icon" src="/assets/hospital.svg" mode="aspectFit"></image>
      <text class="empty-title">暂无住院记录</text>
      <text class="empty-desc">长辈当前没有在院住院</text>
    </view>

    <!-- Wristband info card -->
    <view wx:else class="content">
      <view class="wristband-card">
        <view class="card-header">
          <view class="hospital-icon">
            <text class="hospital-icon-text">🏥</text>
          </view>
          <view class="hospital-info">
            <text class="hospital-name">{{currentStay.hospital}}</text>
            <text class="hospital-bed">住院中 · 床位 {{currentStay.bed}}</text>
          </view>
          <view class="status-badge online">
            <text class="status-dot"></text>
            <text>在线</text>
          </view>
        </view>

        <view class="divider"></view>

        <view class="info-grid">
          <view class="info-item">
            <text class="info-label">入院日期</text>
            <text class="info-value">{{currentStay.admissionDate}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">主管医生</text>
            <text class="info-value">{{currentStay.doctor}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">诊断</text>
            <text class="info-value">{{currentStay.diagnosis}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">腕带类型</text>
            <text class="info-value">{{currentStay.wristbandType}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">腕带编号</text>
            <text class="info-value">{{currentStay.wristbandId}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">预计出院</text>
            <text class="info-value">{{currentStay.dischargeDate}}</text>
          </view>
        </view>
      </view>

      <!-- Treatment records -->
      <view class="section-card">
        <view class="section-title">每日诊疗记录</view>
        <view wx:if="{{treatments.length === 0}}" class="section-empty">
          <text>暂无诊疗记录</text>
        </view>
        <view wx:else class="treatment-list">
          <view wx:for="{{treatments}}" wx:key="id" class="treatment-item">
            <view class="treatment-icon-bg">
              <text class="treatment-icon">{{item.icon}}</text>
            </view>
            <view class="treatment-body">
              <text class="treatment-title">{{item.title}}</text>
              <text class="treatment-desc">{{item.desc}}</text>
            </view>
            <text class="treatment-time">{{item.time}}</text>
          </view>
        </view>
      </view>

      <!-- Verification history -->
      <view class="section-card">
        <view class="section-header">
          <view class="section-title">核验历史</view>
          <text class="section-more" bindtap="viewAllVerifications">全部 ></text>
        </view>
        <view wx:if="{{verifications.length === 0}}" class="section-empty">
          <text>暂无核验记录</text>
        </view>
        <view wx:else class="verification-list">
          <view wx:for="{{verifications}}" wx:key="id" class="verification-item">
            <view class="verify-status-icon {{item.verified ? 'success' : 'fail'}}">
              <text>{{item.verified ? '✓' : '✗'}}</text>
            </view>
            <view class="verify-body">
              <text class="verify-purpose">{{item.purpose}}</text>
              <text class="verify-meta">{{item.verifier}} · {{item.time}}</text>
            </view>
            <view class="verify-result {{item.verified ? 'success' : 'fail'}}">
              <text>{{item.verified ? '已核验' : '未通过'}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>
</view>
