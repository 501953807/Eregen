<view class="page">
  <!-- Filter Tabs -->
  <scroll-view scroll-x class="filter-tabs">
    <view wx:for="{{filters}}" wx:key="*this"
          class="filter-tab {{filterTab === index ? 'active' : ''}}"
          data-index="{{index}}" bindtap="switchFilter">
      {{item}}
    </view>
  </scroll-view>

  <!-- Loading state -->
  <view wx:if="{{loading}}" class="loading-state">
    <text class="loading-icon">🔄</text>
    <text>正在加载告警...</text>
  </view>

  <!-- Alert Items -->
  <view wx:else class="alert-list">
    <block wx:if="{{alerts.length === 0}}">
      <view class="empty-state">
        <text class="empty-icon">✓</text>
        <view class="empty-text">暂无告警</view>
        <text class="empty-sub">无未读 SOS/跌倒告警</text>
      </view>
    </block>

    <block wx:else>
      <block wx:for="{{alerts}}" wx:key="{{item.id}}">
        <view class="alert-item {{item.type==='sos'?'alert-sos':(item.type==='fall'?'alert-fell':'alert-other')}} {{item.status==='unread'?'unread':'' }}">
          <view class="alert-icon">{{item.icon}}</view>
          <view class="alert-body">
            <view class="alert-header">
              <text class="alert-title">{{item.title}}</text>
              <text class="alert-priority P{{item.priority.slice(1)}}">{{item.priority}}</text>
            </view>
            <text class="alert-device">{{item.device}}</text>
            <text class="alert-time">{{formatTime(item.timestamp)}}</text>
          </view>

          <view class="alert-location">
            <text class="location-label">位置：</text>
            <text class="location-text" bindtap="handleOpenLocation, {{item.id}}">{{item.address || '定位中'}}</text>
          </view>

          <view class="alert-actions">
            <button wx:if="{{item.status === 'unread'}}" class="btn ack-btn" size="mini" bindtap="handleAcknowledge, {{item.id}}">标记处理</button>
            <button wx:elif="{{item.status === 'read'}}" class="btn btn-mark" size="mini" disabled>已处理</button>
          </view>

          <!-- Acknowledged timestamp -->
          <view wx:if="{{item.acknowledgedAt}}" class="acknowledged-tag">
            已处理 {{formatTime(item.acknowledgedAt)}}
          </view>
        </view>
      </block>
    </block>
  </view>
</view>
